{
  "name": "@bmnova/web-analytics",
  "version": "0.1.1",
  "description": "Privacy-first web analytics for Next.js that writes to your own BigQuery: visitors, channels (incl. ChatGPT/Perplexity), funnels, errors and AI crawler hits.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmnova/web-analytics.git"
  },
  "keywords": [
    "analytics",
    "bigquery",
    "nextjs",
    "cloudflare-workers",
    "ai-crawlers",
    "llm",
    "privacy"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "sql",
    "bin",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "web-analytics": "bin/setup.mjs"
  },
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "secrets": "gitleaks git --redact --no-banner .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "next": ">=14.2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "gitleaks git --staged --redact --no-banner ."
  },
  "engines": {
    "node": ">=18"
  }
}
