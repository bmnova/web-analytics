# Copy into your site's env (Vercel project settings, `wrangler secret put`, or .env.local).
# Never commit real values. Leaving WA_GCP_SA_KEY empty runs the collector in dry-run mode (logs rows instead of writing).

# Site label written on every row, e.g. "bmnova".
WA_SITE=
# BigQuery destination.
WA_BQ_PROJECT=
WA_BQ_DATASET=web_analytics
# Service account JSON key (whole file contents, one line). Needs roles/bigquery.dataEditor on the dataset only.
WA_GCP_SA_KEY=
# Long random string used to derive the daily visitor-hash salt. Generate: openssl rand -hex 32
WA_SALT_SECRET=
# Comma-separated origins allowed to POST to /api/collect, e.g. https://example.com,https://www.example.com
WA_ALLOWED_ORIGINS=
